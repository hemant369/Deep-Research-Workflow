# ==============================================================================
# Deep-Research Backend Environment Template
# Copy this file to backend/.env for local development, or configure these keys
# as Environment Variables / Secrets in Azure Container Apps / App Service.
# ==============================================================================

# --- 1. LLM Provider & Azure OpenAI (Primary) --------------------------------
# "auto" selects Azure when endpoint + key are set, otherwise falls back to Ollama.
# Use "azure" or "ollama" to force a specific backend.
LLM_PROVIDER=azure

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120

# --- 2. Observability (Langfuse) ---------------------------------------------
# Leave keys empty to run without Langfuse tracing.
# Use http://localhost:3005 for local Docker Langfuse, or https://cloud.langfuse.com in Azure.
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production

# --- 3. API Security & External API Rate Limits ------------------------------
# Comma-separated frontend origins allowed by FastAPI CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Strongly recommended in cloud deployments to avoid GitHub anonymous API throttling.
GITHUB_TOKEN=

# --- 4. Optional Runtime & Tuning Overrides ----------------------------------
# Defaults live in backend/core/config.py; uncomment only when tuning or mounting cloud volumes.
# LOG_DIR=/mnt/logs
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_CONTEXT_SIZE=32768
# OLLAMA_MAX_TOKENS=8192
# MAX_RESEARCH_ROUNDS=2
# MAX_TOTAL_SOURCES=15
# MAX_SEARCH_RESULTS=5
# MAX_EVIDENCE_RESULTS=15
# VALIDATION_BATCH_SIZE=5
# PAGES_PER_QUERY=5
# MAX_PAGE_CHARS=12000
# SEARCH_TIMEOUT_SECONDS=45
# HTTP_TIMEOUT_SECONDS=20
# HTTP_MAX_RETRIES=2
# PAGE_FETCH_TIMEOUT_SECONDS=8
